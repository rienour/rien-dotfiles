// -*- mode: jsonc -*-
[
  {
    "output": ["DP-5"],
    "include": ["$HOME/.config/waybar/main-bar.json"],
    "modules-right": [
      "battery",
      "custom/media",
      "tray",
      "pulseaudio",
      "network",
      "cpu",
      "memory",
      "clock",
    ],
  },
  {
    "output": ["eDP-2", "eDP-1"],
    "include": ["$HOME/.config/waybar/main-bar.json"],
    "modules-right": [
      "battery",
      "custom/media",
      "tray",
      "pulseaudio",
      "network",
      "cpu",
      "memory",
      "clock",
    ],
    "battery": {
      "format": "{capacity}% {icon}",
      "format-icons": {
        "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
      },
    },
  },
  {
    "layer": "top",
    "height": 40,
    "spacing": 0,
    "output": ["HDMI-A-3", "DP-4"],
    "include": ["$HOME/.config/waybar/common-modules.json"],
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "clock"],
    "hyprland/window": {
      "separate-outputs": true,
    },
  },
]
